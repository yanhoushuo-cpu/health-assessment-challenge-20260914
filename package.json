  },
  "devDependencies": {
    "@playwright/test": "^1.63.0",
    "@types/node": "^26.5.1",
    "@types/pg": "^8.23.1",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitest/coverage-v8": "^5.0.0",
    "dotenv": "^17.4.2",
    "embedded-postgres": "^17.7.0-beta.15",
    "eslint": "^9.39.4",
    "eslint-config-next": "^16.3.5",
    "pg": "^8.23.0",
    "prettier": "^3.9.6",
    "prisma": "^6.19.0",
    "tsx": "^4.23.13",
    "typescript": "^6.0.3",
    "vitest": "^5.0.0"
  }
