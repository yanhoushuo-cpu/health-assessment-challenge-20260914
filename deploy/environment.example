# Save a PRIVATE copy at project root as .env.deploy (never commit it).
# Use 64 random hexadecimal characters, avoiding URL-reserved characters.
POSTGRES_PASSWORD=replace_with_random_64_character_hex
APP_ORIGIN=https://quiz.example.com
CADDY_SITE=quiz.example.com
APP_IMAGE=qinghe-app:local
MIGRATE_IMAGE=qinghe-migrate:local
POSTGRES_IMAGE=postgres:17-alpine
CADDY_IMAGE=caddy:2-alpine
# Optional: your own domestic registry addresses for already-imported images.
# NODE_IMAGE=your-registry/node:22-bookworm-slim
# NPM_REGISTRY=https://registry.npmmirror.com
